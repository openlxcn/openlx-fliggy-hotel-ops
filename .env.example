PORT=1989
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:1989
DATA_DIR=./data
# Production: use the existing OpenLX identity service and payment modules.
OPENLX_IDENTITY_ORIGIN=https://wx.openlx.cn
OPENLX_SHARED_ROOT=
# Sales opens only after the relevant product acceptance and real payment validation.
SALES_ENABLED=false

# Central membership public key only; no private key or pass sales in this product.
OPENLX_MEMBERSHIP_PUBLIC_KEY_FILE=

# Product-specific sync key path; created by the shared series service owner.
OPENLX_SERIES_KEY_FILE=
